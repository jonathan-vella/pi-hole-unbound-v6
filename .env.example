SUITE_API_KEY=<set-a-secure-random-key>
SUITE_PORT=8090
SUITE_HOST=127.0.0.1
# Optional: where the Python API stores its data/cache
SUITE_DATA_DIR=/var/lib/pihole-suite/data
# Optional: log verbosity for the Python API (DEBUG, INFO, WARN, ERROR)
SUITE_LOG_LEVEL=INFO
UNBOUND_PORT=5335
NETALERTX_PORT=20211

# Optional unattended notifications for auto-update and boot health check.
# Persist this in /etc/pihole-suite/pihole-suite.env; cron/systemd do not inherit shell exports.
NOTIFY_URL=
DNS_TEST_DOMAIN=debian.org

# Protected backup roots. Override only if you also preserve root ownership and restrictive permissions.
PIHOLE_BACKUP_ROOT=/var/backups/pihole-suite
PIHOLE_AUTO_BACKUP_DIR=/var/backups/pihole-suite/auto-update
PIHOLE_AUTO_BACKUP_RETENTION=8
PIHOLE_BACKUP_DIR=/var/backups/pihole-suite/rescue
PIHOLE_MAINT_BACKUP_DIR=/var/backups/pihole-suite/maintenance
PIHOLE_MAINT_BACKUP_RETENTION=5

# Optional container image overrides. Pin explicit tags in production.
PIHOLE_IMAGE=pihole/pihole:latest
NETALERTX_IMAGE=jokobsk/netalertx:latest
